@prefix ex:   <http://example.org/health#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:F000353 rdf:type ex:CheckupVisit ;
        ex:isCheckup true ;
        ex:attendingDoctor ex:D0007 ;
        ex:patient ex:P002073 ;
        ex:diagnosis "Routine Checkup" ;
        ex:diagnosisType ex:PreliminaryDiagnosis ;
        ex:prescribedDrug "Multivitamins" .

